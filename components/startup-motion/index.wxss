.startup {position:fixed;top:0;right:0;bottom:0;left:0;z-index:100;background:#222733;display:flex;flex-direction:column;align-items:center;justify-content:center;animation:exit .25s ease-in 1.1s forwards;}
.letter-row {display:flex;gap:18rpx;}
.cell {width:64rpx;position:relative;text-align:center;}
.letter {display:block;color:#b5dbc1;font-size:64rpx;line-height:88rpx;font-weight:500;opacity:0;animation:land .4s cubic-bezier(.2,.8,.2,1) forwards;}
.line {height:4rpx;background:#b5dbc1;border-radius:4rpx;transform:scaleX(0);animation:underline .3s ease-out forwards;}
.caption {font-size:28rpx;color:#a8b0c0;margin-top:40rpx;animation:caption .4s ease-out .4s both;}
@keyframes land {from{opacity:0;transform:translateY(-24rpx);}to{opacity:1;transform:translateY(0);}}
@keyframes underline {to{transform:scaleX(1);}}
@keyframes caption {from{opacity:0;}to{opacity:1;}}
@keyframes exit {to{opacity:0;}}
@media (prefers-reduced-motion:reduce) {.startup,.letter,.line,.caption {animation:none;}.letter,.caption{opacity:1;}.line{transform:none;}}
